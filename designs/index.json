own without it). Rests when all eyespots see less than 1%. Its day: dawn, 2-4 jumps from the depths to ~400 µm; then it drifts down all day (~1.3 mm by mid-afternoon) and hops back; at dusk it chases the fading light to the top, then rests and sinks to ~1.6 mm by dawn. Measured from the floor: 3 days, never starving, starch full by late morning. Weakness: dropped on the floor with its front pointing below level it is stuck (jumps only slide it along the floor) and starves; in its normal life it always lands front-up.","design":{"body":{"radius":10},"parts":[{"type":"sensor","id":"eye","label":"Light sensor","at":[10,0],"angle":0,"kind":"light","cone":180,"build":{"tpl":"Light sensor (eyespot)","where":0,"tilt":0,"size":1,"depth":1,"feels":"strangers","flip":false,"id":"eye"},"name":"Eyespot (front)"},{"type":"sensor","id":"eyeL","label":"Light sensor","at":[6.123233995736766e-16,10],"angle":90,"kind":"light","cone":180,"build":{"tpl":"Light sensor (eyespot)","where":90,"tilt":0,"size":1,"depth":1,"feels":"strangers","flip":false,"id":"eyeL"},"name":"Eyespot (left)"},{"type":"sensor","id":"eyeR","label":"Light sensor","at":[-1.8369701987210296e-15,-10],"angle":270,"kind":"light","cone":180,"build":{"tpl":"Light sensor (eyespot)","where":270,"tilt":0,"size":1,"depth":1,"feels":"strangers","flip":false,"id":"eyeR"},"name":"Eyespot (right)"},{"type":"segment","id":"spring_0","parent":"body","at":[-9.659258262890681,2.58819045102521],"angle":180,"length":5,"radius":0.3,"material":"protein","joint":{"type":"motor","rate":500,"swing":40,"phase":0,"burst":{"duration":0.8,"recharge":3,"group":"spring"},"controls":[{"sensor":"eye","min":0,"max":0.15,"also":[{"sensor":"eyeL","min":0,"max":0.15},{"sensor":"eyeR","min":0,"max":0.15}],"all":true},{"sensor":"eye","min":0.015,"max":1,"also":[{"sensor":"eyeL","min":0.015,"max":1},{"sensor":"eyeR","min":0.015,"max":1}]}]},"label":"Spring","build":{"tpl":"Burst organ (escape)","where":165,"tilt":15,"size":0.4,"depth":1,"feels":"strang